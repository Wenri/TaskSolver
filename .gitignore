# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- tooling / env ---
.pixi/
.env

# --- agy/antigravity runtime capture output (see test_scripts/run-agy.sh AGY_PROC_CAPTURE) ---
*.jsonl
captures/

# --- antigravity build deps + artifacts (all under antigravity/, never committed) ---
# Vendored/fetched deps + the built host executable — recreate with `pixi run build-shim`:
#   vendor/libagy.so (~256 MB Go shared library), vendor/frida-gum (devkit),
#   vendor/agy (compiled host executable linked against libagy.so).  UAPI headers are NOT vendored
#   (referenced in place from the kernel-headers_linux-64 conda dep — see CMakeLists.txt).
antigravity/vendor/
# cmake build tree + the compile db it symlinks to the source root (for clangd):
antigravity/build/
antigravity/compile_commands.json
# generated from the raw agy conversion at build time:
antigravity/symbols/symbols.json
antigravity/src/symbols_gen.h
antigravity/symbols/goresym.json
# full addr→name table for stack symbolization (regenerated by `pixi run shim-symbols`):
antigravity/symbols/funcmap.tsv.gz

# --- Claude generated runtime (keep the vendored SDK source pristine) ---
claude/vendor/sdk/src/claude_agent_sdk/_bundled/bun
claude/vendor/sdk/src/claude_agent_sdk/_bundled/source/
claude/vendor/sdk/src/claude_agent_sdk/_bundled/assets/
claude/vendor/sdk/src/claude_agent_sdk/_bundled/modules/
claude/vendor/sdk/src/claude_agent_sdk/_bundled/libwire.node
claude/vendor/sdk/src/claude_agent_sdk/_bundled/cache.mjs
claude/vendor/sdk/src/claude_agent_sdk/_bundled/manifest.json
claude/vendor/sdk/src/claude_agent_sdk/_bundled/bun-graph.txt

# --- kimi-code build artifacts (kimi/) ---
# All covered by the global ignores above: kimi/native/build/ (build/), the vendored tree's
# pnpm install + tsdown outputs (node_modules/, dist/). The build-time vis-web-asset.ts stub is
# ignored by the vendored tree's own apps/kimi-code/.gitignore.

# --- Node (pymport bridge) ---
node_modules/
package-lock.json
