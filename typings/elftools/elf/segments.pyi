from collections.abc import Iterator
from typing import Literal, overload
from .sections import Section

class Segment:
    @overload
    def __getitem__(self, key: Literal["p_type"]) -> str | int: ...
    @overload
    def __getitem__(self, key: Literal["p_vaddr", "p_offset", "p_filesz", "p_memsz", "p_flags", "p_align"]) -> int: ...
    @overload
    def __getitem__(self, key: str) -> object: ...
    def section_in_segment(self, section: Section) -> bool: ...

class NoteSegment(Segment):
    def iter_notes(self) -> Iterator[dict[str, object]]: ...
