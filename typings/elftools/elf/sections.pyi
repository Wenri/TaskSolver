from collections.abc import Iterator
from typing import Literal, overload
from ..construct import Container

class Section:
    name: str
    header: Container
    @overload
    def __getitem__(self, key: Literal["sh_type"]) -> str | int: ...
    @overload
    def __getitem__(self, key: Literal["sh_addr", "sh_size", "sh_offset", "sh_link", "sh_flags", "sh_addralign", "sh_entsize", "sh_info"]) -> int: ...
    @overload
    def __getitem__(self, key: str) -> object: ...
    def data(self) -> bytes: ...

class Symbol:
    name: str
    @overload
    def __getitem__(self, key: Literal["st_value", "st_size", "st_name"]) -> int: ...
    @overload
    def __getitem__(self, key: Literal["st_info"]) -> dict[str, str | int]: ...
    @overload
    def __getitem__(self, key: str) -> object: ...

class SymbolTableSection(Section):
    def iter_symbols(self) -> Iterator[Symbol]: ...
    def get_symbol(self, n: int) -> Symbol: ...
    def get_symbol_by_name(self, name: str) -> list[Symbol] | None: ...
